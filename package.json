{
  "name": "forma-activity-console",
  "version": "0.1.0",
  "private": true,
  "description": "Internal console for cross-project activity data in an Autodesk Forma hub",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:parsing && npm run test:dashboards && npm run test:auth && npm run test:archive",
    "test:parsing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/parsing.test.ts",
    "test:dashboards": "node --conditions=react-server --import ./scripts/resolve-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/dashboards.test.ts",
    "test:auth": "node --conditions=react-server --import ./scripts/resolve-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/authorization.test.ts",
    "test:archive": "node --conditions=react-server --import ./scripts/resolve-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/archive.test.ts",
    "sample-extract": "node --conditions=react-server --import ./scripts/resolve-ts.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-sample-extract.ts sample-extract.zip"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2"
  }
}
