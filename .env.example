# Optional demo-only configuration. No environment file is required.
# The public demo opens directly and makes no APS API calls.
# No APS application, credentials, callback, or session secret is needed.
# Dokku's repository/branch sync settings belong in the hosting UI; see docs/DOKKU.md.
# Changing LENS_MODE on the live main build does not install the demo branch.
LENS_MODE=demo

# Optional external link to a separately hosted live application.
# This never enables live mode or switches this application's dataset.
LENS_LIVE_URL=
