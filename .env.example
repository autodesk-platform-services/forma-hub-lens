# Copy to .env.local and fill in. Never commit the filled-in file.

# This deployment connects to one Forma hub. Access requires Hub Admin or
# Executive Overview on that hub; administrative writes require Hub Admin.

# From https://aps.autodesk.com/myapps — app type must be "Traditional Web App".
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Must exactly match a callback URL registered on the APS app.
APS_CALLBACK_URL=http://localhost:3000/api/aps/callback

# Forma hub ID: the Data Management hub ID with the "b." prefix removed.
FORMA_HUB_ID=

# Optional region hint for the Forma Admin API: US | EMEA | AUS
FORMA_REGION=

DATA_DIR=.data
